      "name": "01 Salud",
      "item": [
        {
          "name": "GET /health - auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });",
                  "const esquema = {\"type\":\"object\",\"required\":[\"service\",\"status\"],\"properties\":{\"service\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}};",
                  "pm.test(\"Esquema JSON: salud auth\", function () { pm.response.to.have.jsonSchema(esquema); });",
                  "pm.test(\"Contenido: salud auth\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.service).to.eql(\"auth\");",
                  "  pm.expect(json.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/health",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
