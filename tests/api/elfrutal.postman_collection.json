                "exec": [
                  "pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });",
                  "const esquema = {\"type\":\"object\",\"required\":[\"idPedido\",\"estado\",\"total\",\"items\"],\"properties\":{\"idPedido\":{\"type\":\"integer\"},\"estado\":{\"type\":\"string\",\"enum\":[\"recibido\",\"en_preparacion\",\"listo\",\"entregado\",\"cancelado\"]},\"total\":{\"type\":\"number\"},\"items\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"required\":[\"idProducto\",\"nombre\",\"cantidad\",\"subtotal\"],\"properties\":{\"idProducto\":{\"type\":\"integer\"},\"nombre\":{\"type\":\"string\"},\"cantidad\":{\"type\":\"integer\"},\"subtotal\":{\"type\":\"number\"}}}}}};",
