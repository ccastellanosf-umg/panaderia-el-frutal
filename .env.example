# ============================================================
# .env.example
# Copiar como ".env" y completar con valores reales.
# El archivo ".env" NUNCA debe subirse al repositorio.
# ============================================================

# Base de datos (compartida por los 4 microservicios)
DB_NAME=panaderia_el_frutal
DB_USER=elfrutal_admin
DB_PASSWORD=cambiar_esta_clave_segura

# Redis (caché de catálogo y sesiones de autenticación)
REDIS_URL=redis://redis:6379

# Autenticación
JWT_SECRET=cambiar_este_secreto_por_uno_largo_y_aleatorio

# Puertos de cada microservicio (coinciden con docker-compose.yml)
AUTH_PORT=3001
CATALOGO_PORT=3002
PEDIDOS_PORT=3003
PAGOS_PORT=3004

# Solo en Azure App Service (no se usa en docker-compose local):
# DATABASE_URL=postgresql://usuario:clave@servidor.postgres.database.azure.com:5432/panaderia_el_frutal?sslmode=require
